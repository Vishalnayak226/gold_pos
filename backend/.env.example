# Copy to .env and fill in per-tenant values. Loaded automatically via
# `import 'dotenv/config'` at the top of server.js. Never commit the real
# .env file — it's excluded in .gitignore.

# Port the Node process binds to (localhost only — Nginx is the public listener)
PORT=5000

# Central licensing server this tenant's POS checks in against.
# The platform owner's production licensing_server URL, e.g.:
# LICENSING_SERVER_URL=https://license.yourpos.com
LICENSING_SERVER_URL=http://127.0.0.1:6060

NODE_ENV=production

# This install's own public https:// origin — the address Razorpay delivers
# webhooks to. Required whenever NODE_ENV=production: backend/productionGuard.js
# refuses to bind the port without it (or settings.publicUrl), because a capture
# that cannot be confirmed server-to-server silently loses the credit for money
# already taken. Must be https — payment callbacks never traverse plaintext.
# PUBLIC_URL=https://app.yourpos.com

# Optional comma-separated browser origins allowed to call this API from a
# different site. Leave blank for the normal same-origin deployment.
# CORS_ORIGINS=https://pos.example.com,https://admin.example.com

# ---------------------------------------------------------------------------
# Secret-vault key — REQUIRED IN PRODUCTION.
#
# The credentials inside settings.json (Razorpay secret, SMTP password, the
# tenant auth salt, every operator PIN hash and TOTP secret) are encrypted at
# rest with AES-256-GCM under this key. Exactly 64 hexadecimal characters.
#
# Mint one with:   node backend/rotateSecretKey.js --generate
#
# Outside production the server falls back to a development keyfile written
# into the data directory. Production REFUSES that fallback and will not start
# without this variable, because a key stored beside the data it protects
# defends against nothing — and theft of the data directory is precisely the
# loss this control exists to answer.
#
# Rotating it: stop the server, run
#   node backend/rotateSecretKey.js --generate-new
# then set the printed value here before starting again. Full procedure and
# recovery path: docs/RUNBOOKS.md.
# GOLD_POS_SECRET_KEY=
