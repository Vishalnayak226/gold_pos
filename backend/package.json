{
  "name": "gold-pos-backend",
  "version": "1.2.0",
  "description": "Lightweight, future-proof backend server for SaaS Gold POS",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "test": "node test_billing_math.js && node test_schema.js && node test_repositories.js && node test_concurrency.js && node test_suite.js && node test_routes.js && node test_http.js && node test_production_guard.js",
    "test:billing": "node test_billing_math.js",
    "test:schema": "node test_schema.js",
    "test:repositories": "node test_repositories.js",
    "test:concurrency": "node test_concurrency.js",
    "migrate": "node repositories/migrate.js",
    "migrate:status": "node repositories/migrate.js --status",
    "import:legacy": "node importLegacyJson.js",
    "import:legacy:dry-run": "node importLegacyJson.js --dry-run",
    "test:integration": "node test_suite.js",
    "test:routes": "node test_routes.js",
    "test:http": "node test_http.js",
    "test:guard": "node test_production_guard.js",
    "test:e2e": "playwright test",
    "seed": "node seed.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "helmet": "^8.3.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.5",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
