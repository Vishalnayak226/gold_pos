# Reverse proxy + TLS termination for one tenant's POS instance.
# Copy to /etc/nginx/sites-available/<tenant-slug>, replace __DOMAIN__ and
# __PORT__, symlink into sites-enabled, then run:  certbot --nginx -d __DOMAIN__
# See deploy/README.md §4.

server {
    listen 80;
    server_name __DOMAIN__;

    location / {
        proxy_pass http://127.0.0.1:__PORT__;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }

    client_max_body_size 8m; # server.js accepts up to 5mb JSON bodies (company logo uploads)
}

# certbot --nginx will add the listen 443 ssl server block and the
# 80->443 redirect automatically. Do not hand-write the TLS block —
# let certbot manage cert renewal paths.
