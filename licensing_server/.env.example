# Copy to .env and fill in. Loaded automatically via `import 'dotenv/config'`
# at the top of server.js. Never commit the real .env file.

# Avoid port 6000 — it's on the WHATWG Fetch forbidden-port list (X11),
# which breaks the POS client's fetch()-based license handshake outright.
PORT=6060

# Bearer token guarding the admin dashboard (/api/admin/keys, the control
# panel UI). Generate a real random secret for production — the shipped
# default (MASTER-ADMIN-SECRET-12345) is a local-dev placeholder only.
ADMIN_SECRET=MASTER-ADMIN-SECRET-12345

NODE_ENV=production
